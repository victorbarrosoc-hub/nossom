# Optional PUBLIC ElevenLabs agent ID. Never put API keys in NEXT_PUBLIC variables.
# Configure domain allowlisting and spending limits in the ElevenLabs dashboard.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Private server-side Anthropic credentials. Never prefix these with NEXT_PUBLIC.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# At least 16 random characters; unlocks the paid API in this personal studio.
NOSSOM_AI_ACCESS_CODE=
